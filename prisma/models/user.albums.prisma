model UserAlbum {
  id           Int      @id @default(autoincrement())
  name         String
  createdAt    DateTime @default(now())
  previewImage String?
  userId       Int
  shown        Boolean @default(true)
  topicId      Int?
  user         User     @relation(fields: [userId], references: [id])
  images       Image[]  @relation("AlbumImages")
}