model Post {
  id         Int     @id @default(autoincrement())
  title      String
  topic      String?
  tags       String?
  content    String
  views      Int     @default(0)
  likes      Int     @default(0)
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  images     Image[]  @relation("PostImages")
  links      Link[]   
}