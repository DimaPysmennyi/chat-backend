model Post {
  id      Int     @id @default(autoincrement())
  title   String
  topic   String?
  tags    String?
  content String
  views   Int     @default(0)
  likes   Int     @default(0)
  user    User    @relation(fields: [userId], references: [id])
  userId  Int
  images  Image[]
  links   String?
}
