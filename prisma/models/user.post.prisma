model UserPost {
  id         Int     @id @default(autoincrement())
  title      String
  topic      String?
  tags       String?
  content    String
  links      String?
  views      Int     @default(0)
  likes      Int     @default(0)
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  postImages Image[]  @relation("PostImages")
  postLinks  Link[]   
}