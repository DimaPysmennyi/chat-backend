model ChatMessage {
  id            Int       @id @default(autoincrement())
  content       String
  sentAt        DateTime  @default(now())
  attachedImage Image[]   
  author        User      @relation("MessageAuthor", fields: [authorId], references: [id])
  authorId      Int
  chatGroup     ChatGroup @relation(fields: [chatGroupId], references: [id])
  chatGroupId   Int
}
