model Album {
  id           Int      @id @default(autoincrement())
  name         String
  createdAt    DateTime @default(now())
  previewImage String?
  userId       Int
  shown        Boolean  @default(true)
  topic        String
  user         User     @relation(fields: [userId], references: [id])
  images       Image[]
}

model Avatar {
  id     Int     @id @default(autoincrement())
  image  String
  userId Int
  active Boolean @default(true)
  shown  Boolean @default(true)
  user   User    @relation(fields: [userId], references: [id])
}

model ChatGroup {
  id             Int            @id @default(autoincrement())
  name           String?
  isPersonalChat Boolean        @default(false)
  avatar         String?
  adminId        Int
  admin          User           @relation("GroupAdmin", fields: [adminId], references: [id])
  members        UsersOnChats[]
  messages       ChatMessage[]
}

model ChatMessage {
  id            Int       @id @default(autoincrement())
  content       String
  sentAt        DateTime  @default(now())
  attachedImage Image[]
  author        User      @relation("MessageAuthor", fields: [authorId], references: [id])
  authorId      Int
  chatGroup     ChatGroup @relation(fields: [chatGroupId], references: [id])
  chatGroupId   Int
}

model Friendship {
  id         Int     @id @default(autoincrement())
  accepted   Boolean @default(false)
  profile1   User    @relation(name: "friendship_sent_request", fields: [profile1Id], references: [id])
  profile2   User    @relation(name: "friendship_accepted_request", fields: [profile2Id], references: [id])
  profile1Id Int
  profile2Id Int
}

model Image {
  id         Int          @id @default(autoincrement())
  filename   String
  file       String       @default("/images/posts")
  uploadedAt DateTime     @default(now())
  post       Post?        @relation(fields: [postId], references: [id])
  postId     Int?
  album      Album?       @relation(fields: [albumId], references: [id])
  albumId    Int?
  message    ChatMessage? @relation(fields: [messageId], references: [id])
  messageId  Int?
}

model Link {
  id  Int    @id @default(autoincrement())
  url String
}

model Post {
  id      Int     @id @default(autoincrement())
  title   String
  topic   String?
  tags    String?
  content String
  views   Int     @default(0)
  likes   Int     @default(0)
  user    User    @relation(fields: [userId], references: [id])
  userId  Int
  images  Image[]
  links   String?
}

model User {
  id                 Int            @id @default(autoincrement())
  username           String?
  email              String         @unique
  firstname          String?
  lastname           String?
  password           String
  image              String?
  birthdate          String?
  posts              Post[]
  albums             Album[]
  sentRequests       Friendship[]   @relation(name: "friendship_sent_request")
  receivedRequests   Friendship[]   @relation(name: "friendship_accepted_request")
  avatars            Avatar[]
  sentMessages       ChatMessage[]  @relation("MessageAuthor")
  chatGroups         UsersOnChats[]
  administeredGroups ChatGroup[]    @relation("GroupAdmin")
}

model UsersOnChats {
  user   User      @relation(fields: [userId], references: [id])
  userId Int
  chat   ChatGroup @relation(fields: [chatId], references: [id])
  chatId Int

  @@id([userId, chatId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
