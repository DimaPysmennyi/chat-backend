model Album {
  id           Int      @id @default(autoincrement())
  name         String
  createdAt    DateTime @default(now())
  previewImage String?
  userId       Int
  shown        Boolean  @default(true)
  topicId      Int?
  user         User     @relation(fields: [userId], references: [id])
  images       Image[]  @relation("AlbumImages")
}

model Avatar {
  id     Int     @id @default(autoincrement())
  image  String
  userId Int
  active Boolean @default(true)
  shown  Boolean @default(true)
  user   User    @relation(fields: [userId], references: [id])
}

model ChatGroup {
  id             Int           @id @default(autoincrement())
  name           String
  isPersonalChat Boolean       @default(false)
  avatar         String?
  adminId        Int
  admin          User          @relation("GroupAdmin", fields: [adminId], references: [id])
  members        User[]        @relation("GroupMembers")
  messages       ChatMessage[]
}

model ChatMessage {
  id            Int       @id @default(autoincrement())
  content       String
  sentAt        DateTime  @default(now())
  attachedImage String?
  authorId      Int
  chatGroupId   Int
  author        User      @relation("MessageAuthor", fields: [authorId], references: [id])
  chatGroup     ChatGroup @relation(fields: [chatGroupId], references: [id])
}

model Friend {
  id           Int     @id @default(autoincrement())
  friendUserId Int
  friendOfId   Int
  accepted     Boolean @default(false)
  friendUser   User    @relation(name: "Friend", fields: [friendUserId], references: [id])
  friendOf     User    @relation(name: "FriendOf", fields: [friendOfId], references: [id])
}

model Image {
  id         Int      @id @default(autoincrement())
  filename   String
  url        String
  uploadedAt DateTime @default(now())
  posts      Post[]   @relation("PostImages")
  albums     Album[]  @relation("AlbumImages")
}

model Link {
  id     Int    @id @default(autoincrement())
  url    String
  postId Int
  post   Post   @relation(fields: [postId], references: [id])
}

model Post {
  id         Int     @id @default(autoincrement())
  title      String
  topic      String?
  tags       String?
  content    String
  links      String?
  views      Int     @default(0)
  likes      Int     @default(0)
  userId     Int
  user       User    @relation(fields: [userId], references: [id])
  postImages Image[] @relation("PostImages")
  postLinks  Link[]
}

model User {
  id                 Int           @id @default(autoincrement())
  username           String?
  email              String        @unique
  firstname          String?
  lastname           String?
  password           String
  image              String?
  birthdate          String?
  posts              Post[]
  albums             Album[]
  friendOf           Friend[]      @relation(name: "FriendOf")
  friends            Friend[]      @relation(name: "Friend")
  avatars            Avatar[]
  sentMessages       ChatMessage[] @relation("MessageAuthor")
  chatGroups         ChatGroup[]   @relation("GroupMembers")
  administeredGroups ChatGroup[]   @relation("GroupAdmin")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
